function verificar (){
    var data = new Date()
    var ano = data.getFullYear()
    var fano = document.getElementById('txtano')
    var res = document.querySelector('div#res')

    if(fano.value.length == 0 || Number(fano.value) > ano){
        window.alert('Verifique os dados e tente novamente!')
    } else {
        var fsex = document.getElementsByName('radsex')
        var idade = ano - Number(fano.value)
        var genero = ''
        var img = document.createElement('img')
        img.setAttribute('id', 'foto')

        if (fsex[0].checked){
            genero = 'Homem'
            if (idade >= 0 && idade < 10){
                // Criança
                img.setAttribute('src', 'menino.avif')
            } else if (idade < 21){
                // Jovem
                img.setAttribute('src', 'jovem-m.avif')
            } else if (idade < 50){
                // Adulto
                img.setAttribute('src', 'homem.avif')
            } else {
                // Idoso
                img.setAttribute('src', 'idoso.avif')
            }
        } else if (fsex[1].checked){
            genero = 'Mulher'
            if (idade >= 0 && idade < 10){
                // Criança
                img.setAttribute('src', 'menina.avif')
            } else if (idade < 21){
                // Jovem
                img.setAttribute('src', 'jovem-f.avif')
            } else if (idade < 50){
                // Adulta
                img.setAttribute('src', 'mulher.avif')
            } else {
                // Idosa
                img.setAttribute('src', 'idosa.avif')
            }
        }

        // Escreve o texto e insere a imagem dentro da div #res
        res.style.textAlign = 'center'
        res.innerHTML = `Detectamos ${genero} com ${idade} anos.<br>`
        res.appendChild(img)
    }
}